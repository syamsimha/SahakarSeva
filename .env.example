# ==========================================================
# SahakarSeva Environment Configuration (.env.example)
# ==========================================================

# Supabase Public Configuration for SahakarSeva
# Obtain these from your Supabase Project Settings -> API
# NOTE: Only use public anon key here. NEVER expose your service_role key in the mobile client!
# If omitted, the app automatically runs on the persistent browser localStorage database.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here
EXPO_PUBLIC_APP_URL=http://localhost:8081

# Google Maps Platform (Web JavaScript API Key)
# Obtain from Google Cloud Console -> APIs & Services -> Credentials
# If omitted, the app will gracefully fall back to an interactive OpenStreetMap / Leaflet map.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
