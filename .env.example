# ==========================================================
# SahakarSeva Environment Configuration
# ==========================================================

# Google Maps Platform (Web JavaScript API Key)
# Obtain from Google Cloud Console -> APIs & Services -> Credentials
# If omitted, the app will gracefully fall back to an interactive OpenStreetMap / Leaflet map.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Supabase Project Credentials
# Obtain from your Supabase Project Settings -> API
# If omitted, the app automatically runs on persistent browser localStorage database.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
